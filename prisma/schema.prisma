// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  tenantId      String?
  email         String?   @unique
  phone         String    @unique
  password      String?
  firstName     String?
  lastName      String?
  fullName      String?
  username      String?   @unique
  role          Role      @default(CUSTOMER)
  isActive      Boolean   @default(true)
  isVerified    Boolean   @default(false)
  otpAttempts   Int       @default(0)
  lastOtpSentAt DateTime?
  isMfaEnabled  Boolean   @default(false)
  mfaSecret     String?
  image         String?
  isDeleted     Boolean   @default(false)

  // soft delete
  deletedBy    User?     @relation("UserDeleter", fields: [deletedById], references: [id])
  deletedById  String?
  deletedAt    DateTime?
  deletedUsers User[]    @relation("UserDeleter")
  

  // Admin specific fields
  restaurantAdmin Restaurant? @relation("RestaurantAdmin")
  branchId          String?
  branch            Branch?        @relation(fields: [branchId], references: [id])
  loginHistory      LoginHistory[]

  userPromotions UserPromotion[]

  // Relations
  orders        Order[]        @relation("UserOrders")
  riderOrders   Order[]        @relation("RiderOrders")

  createdFoods  Food[]        @relation("FoodCreator")
  updatedFoods  Food[]        @relation("FoodUpdater")
  deletedAddons Addon[]       @relation("AddonDeleter")
  deletedBranch Branch[]      @relation("BranchDeleter")
  branchStaff   BranchStaff[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // Relations
  restaurantStaff RestaurantStaff[] @relation("RestaurantStaff")
  createdAddons Addon[] @relation("AddonCreator") // Changed from Addon
  updatedAddons Addon[] @relation("AddonUpdater") // Changed from Addon

  // createdAddonGroups AddonGroup[] @relation("AddonGroupCreator")
  // updatedAddonGroups AddonGroup[] @relation("AddonGroupUpdater")

  cart          Cart[]
  notifications Notification[]
  auditLogs     AuditLog[]
  Manager       Manager?
  Address       Address[]
  Feedback      Feedback[]
  userPoints    UserPoints[]
  checkouts     Checkout[]

  updatedRestaurantSettings RestaurantSettings[] @relation("RestaurantSettingsUpdater")

  @@unique([phone, tenantId])    // Allow same phone across different tenants
  @@unique([email, tenantId])    // Allow same email across different tenants
  @@unique([username, tenantId]) // Allow same username across different tenants
  
  @@index([tenantId])           // For tenant filtering
  @@index([phone, isActive])    // For phone + active status queries
  @@index([email, isActive])    // For email + active status queries
  @@index([username, isActive]) // For username + active status queries
  @@unique([tenantId, isActive])

  @@map("users")
}

model OTP {
  id            String    @id @default(cuid())
  phone         String
  code          String
  otpAttempts   Int       @default(0)
  lastOtpSentAt DateTime?
  used          Boolean   @default(false)
  expiresAt     DateTime
}

enum Role {
  SUPER_ADMIN // Full system access
  ADMIN // Multiple branch access
  SUB_ADMIN // Single branch access
  MANAGER // Single branch access
  MODERATOR // Limited branch access
  RIDER // Delivery access
  CUSTOMER // Basic access
  STAFF // Branch staff access
  DELIVERY_BOY // Delivery access
}

enum StaffRole {
  ADMIN
  SUB_ADMIN
  MANAGER
  MODERATOR
  RIDER
  STAFF
}

model LoginHistory {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  loginTime  DateTime    @default(now())
  status     LoginStatus
  deviceInfo String?
  ipAddress  String?
  userAgent  String?
  location   String? // For storing geo-location
}

// not needed
enum AdminRole {
  SUPER_ADMIN
  MANAGER
  RIDER
}

enum LoginStatus {
  SUCCESS
  FAILED
  BLOCKED
}


model Branch {
  id                  String    @id @default(cuid())
  name                String
  tenantId            String
  description         String?
  address             String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  isActive            Boolean   @default(true)
  isDefault           Boolean   @default(false)
  // Relations with managers and orders
  foods               Food[]    @relation("BranchFood")
  managers            Manager[]
  orders              Order[]
  phoneNumber         String?
  email               String?
  // coordinates         String? // Store latitude,longitude
  latitude            String?
  longitude           String?
  deliveryRadius      Decimal?  @db.Decimal(10, 2) // in kilometers
  isDeliveryAvailable Boolean   @default(true)
  isTakeawayAvailable Boolean   @default(true)
  isDineInAvailable   Boolean   @default(true)
  isDeleted           Boolean   @default(false)
  deletedAt           DateTime?
  deletedBy           User?     @relation("BranchDeleter", fields: [deletedById], references: [id])
  deletedById         String?

  // audit logs
  auditLogs AuditLog[]

  // restaurant relation
  restaurantId String?
  Restaurant   Restaurant? @relation("RestaurantBranches", fields: [restaurantId], references: [id], onDelete: Cascade)
  User         User[]

  // default branch
  defaultForRestaurant Restaurant? @relation("DefaultBranch")

  // branch variants
  branchVariants BranchVariant[] 
  branchAddons BranchAddon[]

  // business hours
  BusinessHours BusinessHours[]

  // cart
  Cart Cart[]

  // promotion
  Promotion Promotion[]

  // branch food
  branchFood             BranchFood[]
  branchDeliverySettings BranchDeliverySettings[]
  checkouts              Checkout[]
  branchStaff            BranchStaff[]
  branchOverrides BranchOverrides[]

  @@index([tenantId])
  @@index([restaurantId])
}

// branch staff management
model BranchStaff {
  id     String @id @default(cuid())
  userId String
  tenantId String

  role     BranchStaffRole // Admin, manager, rider, customer
  isActive Boolean @default(true)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, branchId])
  @@index([tenantId])
}

// not needed
enum BranchStaffRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  MODERATOR
  STAFF
  RIDER
}

model BusinessHours {
  id          String  @id @default(cuid())
  tenantId    String
  branchId    String
  branch      Branch  @relation(fields: [branchId], references: [id])
  dayOfWeek   String // 0-6 (Sunday-Saturday)
  openingTime String // 24-hour format
  closingTime String // 24-hour format
  isClosed    Boolean @default(false)

  // Order Receiving hours (optional)
  orderReceivingStart String?
  orderReceivingEnd   String?

  // temporary changes
  temporaryClose              Boolean   @default(false)
  temporaryCloseStart         DateTime?
  temporaryCloseEnd           DateTime?
  temporaryCloseReasonMessage String?

  @@unique([branchId, dayOfWeek, tenantId])
  @@index([branchId])
  @@index([tenantId, branchId])
}

model BranchDeliverySettings {
  id                String  @id @default(cuid())
  tenantId          String
  branchId          String  @unique
  branch            Branch  @relation(fields: [branchId], references: [id])
  baseDeliveryFee   Decimal @db.Decimal(10, 2)
  deliveryZones     Json? // Store custom delivery zones and fees
  distanceBasedFees Json? // Store distance based fees
  maxDeliveryRadius Decimal @db.Decimal(10, 2)

  @@unique([branchId, tenantId])
  @@index([branchId])
  @@index([tenantId])
}

// not needed
model Manager {
  id        String   @id @default(cuid())
  userId    String   @unique
  tenantId  String
  branchId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

 @@unique([userId, branchId, tenantId])
  @@index([tenantId])
  @@index([tenantId, branchId])  // Add this for tenant-specific branch queries
}

model Category {
  id          String     @id @default(cuid())
  tenantId    String
  name        String
  description String?
  parentId    String? // For subcategories
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  foods       Food[]
  branchFoods BranchFood[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdBy   String?
  updatedBy   String?
  isActive    Boolean    @default(true)

  // relation


  @@index([tenantId])
}

model Food {
  id            String         @id @default(cuid())
  tenantId      String
  name          String
  description   String?
  basePrice     Decimal        @db.Decimal(10, 2)
  version       Int           @default(1)  // Add version control
  isShared      Boolean        @default(false)

  // Core settings
  isGlobal      Boolean        @default(false)
  branchId        String?      // Branch-specific
  targetBranchIds String[]  // list of branch ids for global food
  allowCustomization Boolean   @default(true)
  baseRecipe    Json?
  status        FoodStatus     @default(DRAFT)
  approvalStatus ApprovalStatus @default(PENDING)

  // Visibility and marketing
  isActive      Boolean        @default(true)
  isPopular     Boolean?       @default(false)
  isRecommended Boolean?       @default(false)
  isNewArrival  Boolean?       @default(false)
  isFeatured    Boolean?       @default(false)
  discountedPrice   Decimal?      @db.Decimal(10, 2)
  haveDiscount      Boolean?      @default(false)
  offer             String?
  freeDelivery      Boolean?      @default(false)
  specialDeliveryFee Boolean?      @default(false)
  topSnacks         Boolean?      @default(false)
  dynamicHome      Boolean?      @default(false)
  trending         Boolean?      @default(false)
  isFree            Boolean?      @default(false)
  expiryDate       DateTime?
  availableStartTime String?
  availableEndTime String?
  trendingStartTime String?
  trendingEndTime String?
  
  // Pricing and offers
  minOrderQuantity   Int          @default(1)

  // Availability
  availabilityConfig Json? // Structured JSON for all time-related configs
  
  // Relations
  foodImages    FoodImage[]
  categories    Category[]
  variants      FoodVariant[]
  foodAddons    FoodAddon[]
  branches      Branch[]       @relation("BranchFood")
  branchFood    BranchFood[]
  branchOverrides BranchOverrides[]
  defaultImageUrl String?
  
  // Audit
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  createdBy     User?          @relation("FoodCreator", fields: [createdById], references: [id])
  createdById   String?
  updatedBy     User?          @relation("FoodUpdater", fields: [updatedById], references: [id])
  updatedById   String?

  // Other relations
  priceHistory  PriceHistory[]
  promotions    Promotion[]
  checkoutItems CheckoutItem[]
  cartItems     CartItem[]
  OrderItem     OrderItem[]
  campaign      Campaign?      @relation(fields: [campaignId], references: [id])
  campaignId    String?

  @@index([tenantId])
  @@index([isActive, isPopular])
  @@index([isActive, isRecommended])
  @@index([isActive, isNewArrival])
  @@index([branchId])
  @@index([isGlobal])
}

model BranchFood {
 id          String   @id @default(cuid())
  branchId    String
  foodId      String
  tenantId    String
  version     Int      @default(1)

  // Basic info
  name        String
  description String?
  basePrice   Decimal  @db.Decimal(10, 2)
  
  // Core settings
  allowCustomization Boolean   @default(true)
  baseRecipe    Json?
  status        FoodStatus     @default(DRAFT) // Default to PUBLISHED since it's copied from approved food

  // Visibility and marketing
  isActive      Boolean        @default(true)
  isPopular     Boolean?       @default(false)
  isRecommended Boolean?       @default(false)
  isNewArrival  Boolean?       @default(false)
  isFeatured    Boolean?       @default(false)
  discountedPrice   Decimal?      @db.Decimal(10, 2)
  haveDiscount      Boolean?      @default(false)
  offer             String?
  freeDelivery      Boolean?      @default(false)
  specialDeliveryFee Boolean?      @default(false)
  topSnacks         Boolean?      @default(false)
  dynamicHome       Boolean?      @default(false)
  trending          Boolean?      @default(false)
  isFree            Boolean?      @default(false)
  
  // Time-related fields
  expiryDate       DateTime?
  availableStartTime String?
  availableEndTime   String?
  trendingStartTime  String?
  trendingEndTime    String?
  
  // Pricing and offers
  minOrderQuantity   Int          @default(1)

  // Availability
  availabilityConfig Json?
  isAvailable     Boolean  @default(true)
  stockStatus     StockStatus @default(IN_STOCK)
  preparationTime Int?

  // Images
  defaultImageUrl String?
  foodImages    BranchFoodImage[]

  // Relations
  branch      Branch   @relation(fields: [branchId], references: [id])
  food        Food     @relation(fields: [foodId], references: [id])
  categories  Category[]
  variants    BranchFoodVariant[]
  addons      BranchFoodAddon[]

  // Audit
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   String?
  
  @@unique([tenantId, branchId, foodId])
  @@index([tenantId])
  @@index([branchId])
  @@index([isActive, isPopular])
  @@index([isActive, isRecommended])
  @@index([isActive, isNewArrival])
  @@index([isActive, isFeatured])
}

model BranchFoodImage {
  id            String     @id @default(cuid())
  branchFoodId  String
  branchFood    BranchFood @relation(fields: [branchFoodId], references: [id])
  url           String
  deviceType    DeviceType
  width         Int
  height        Int
  size          Int
  createdAt     DateTime   @default(now())

  @@unique([branchFoodId, deviceType])
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

model BranchFoodVariant {
  id              String   @id @default(cuid())
  tenantId        String
  branchFoodId    String
  name            String
  description     String?
  basePrice       Decimal  @db.Decimal(10, 2)
  isRequired      Boolean  @default(false)
  
  // Visibility and stock
  isActive        Boolean  @default(true)
  isAvailable     Boolean  @default(true)
  stockStatus     StockStatus @default(IN_STOCK)
  
  // Marketing
  discountedPrice Decimal?  @db.Decimal(10, 2)
  haveDiscount    Boolean?  @default(false)
  
  // Relations
  branchFood      BranchFood @relation(fields: [branchFoodId], references: [id], onDelete: Cascade)
  
  // For tracking original variant
  originalVariantId String?
  
  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedBy       String?

  // Relations for orders/cart
  OrderItem       OrderItem[]
  CartItem        CartItem[]
  checkoutItems   CheckoutItem[]

  @@index([branchFoodId])
  @@index([tenantId])
}

model BranchFoodAddon {
  id              String   @id @default(cuid())
  tenantId        String
  branchFoodId    String

  name            String
  description     String?
  price           Decimal  @db.Decimal(10, 2)
  
  // Addon specific settings
  maxSelections   Int      @default(1)
  isRequired      Boolean  @default(false)
  displayOrder    Int      @default(0)
  
  // Visibility and stock
  isActive        Boolean  @default(true)
  isAvailable     Boolean  @default(true)
  stockStatus     StockStatus @default(IN_STOCK)
  
  // Additional info
  preparationTime Int?
  allergens       String[]
  nutritionInfo   Json?
  imageUrl        String?

  
  
  // Relations
  addonId         String
  branchAddonId    String
  branchAddon    BranchAddon @relation(fields: [branchAddonId], references: [id])
  addon           Addon @relation(fields: [addonId], references: [id])
  branchFood      BranchFood @relation(fields: [branchFoodId], references: [id], onDelete: Cascade)
  
  // For tracking original addon
  originalAddonId String?
  
  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedBy       String?

  @@index([branchFoodId])
  @@index([tenantId])
}



model BranchOverrides {
  id String @id @default(cuid())
  tenantId String
  branchId String
  foodId String
  type FoodType
  field String
  value Json
  variantId String?
  addonId String?
  globalVersion Int?
  branchVersion Int?

  // relations
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)



 @@unique([tenantId, branchId, foodId, type, field]) // Ensures unique overrides per field
  @@index([tenantId])
  @@index([tenantId, branchId, foodId])
  @@index([tenantId, branchId])
  @@index([tenantId, foodId])
  @@index([tenantId, type, field])
}

enum FoodType {
  FOOD
  ADDON
  VARIANT
}

enum FoodStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model FoodImage {
  id         String     @id @default(cuid())
  foodId     String
  food       Food       @relation(fields: [foodId], references: [id])
  url        String
  deviceType DeviceType
  width      Int
  height     Int
  size       Int // in bytes
  createdAt  DateTime   @default(now())

  @@unique([foodId, deviceType])
}

enum DeviceType {
  MOBILE
  TABLET
  DESKTOP
}

