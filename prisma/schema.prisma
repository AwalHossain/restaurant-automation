// New model needed
model Campaign {
  id                 String          @id @default(cuid())
  tenantId           String
  name               String
  description        String?
  startDate          DateTime
  endDate            DateTime
  isActive           Boolean         @default(true)
  type               CampaignType
  discountPercentage Decimal?        @db.Decimal(5, 2)
  images             CampaignImage[]
  priority           Int             @default(0)
  targetAudience     Json? // Audience targeting info
  budget             Decimal?        @db.Decimal(10, 2)
  displayLocation    String? // Location on the site (e.g., homepage, menu page)
  redemptionLimit    Int? // Maximum redemptions allowed
  conditions         Json? // Campaign-specific rules (e.g., "minOrderAmount": 20)
  promoCode          String? // Promo code for the campaign
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  foods              Food[]

  @@index([tenantId])
}

model CampaignImage {
  id         String      @id @default(cuid())
  campaignId String
  campaign   Campaign    @relation(fields: [campaignId], references: [id])
  url        String?
  width      Int
  height     Int
  size       Int
  deviceType DeviceType?
}

enum CampaignType {
  SEASONAL // e.g., Summer, Winter
  FESTIVAL // e.g., Ramadan, Christmas
  HAPPY_HOUR // Discount during specific hours
  WEEKEND_SPECIAL // Available only on weekends
  NEW_MENU_ITEM // Promoting a new dish or menu
  BOGO // "Buy One Get One" offers
  LOYALTY_REWARD // Targeted to loyal or repeat customers
  HOLIDAY // e.g., Christmas, Valentine's Day specials
  FAMILY_PACKAGE // Special packages for families or groups
  DELIVERY_ONLY // Discounts for delivery orders only
  IN_STORE_ONLY // Discounts for dine-in customers
}

model FoodVariant {
  id            String         @id @default(cuid())
  tenantId      String
  name          String
  description   String?
  basePrice     Decimal        @db.Decimal(10, 2)
  isRequired    Boolean        @default(false)
 branchId   String?  // Null for global variants, set for branch-specific variants scope      VariantScope @default(GLOBAL) // GLOBAL or BRANCH

  foodId        String
  food          Food           @relation(fields: [foodId], references: [id])
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  priceHistory  PriceHistory[]
  OrderItem     OrderItem[]
  CartItem      CartItem[]
  checkoutItems CheckoutItem[]

  // branch variants
  branchVariants BranchVariant[]

  @@index([tenantId])

}

enum VariantScope {
  GLOBAL
  BRANCH
  BRANCH_SPECIFIC
}


model BranchVariant {
  id              String   @id @default(cuid())
  tenantId        String
  branchId        String
  variantId       String
  overridePrice   Decimal?  @db.Decimal(10, 2) // Branch-specific price override
  isAvailable     Boolean   @default(true)     // Availability at the branch level
  customName      String?   // Optional branch-specific name (e.g., "Super Large")

  // Relations
  branch          Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  variant         FoodVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  parentId String?
  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([tenantId, branchId, variantId]) // Ensure unique overrides per branch-variant combination
  @@index([tenantId, branchId])
}


model FoodAddon {
  id            String  @id @default(cuid())
  tenantId      String
  foodId        String
  addonId       String
  branchId      String?
  maxSelections Int     @default(1) // Maximum times this addon can be selected
  isRequired    Boolean @default(false)
  displayOrder  Int     @default(0)
  isActive      Boolean @default(true)

  food  Food  @relation(fields: [foodId], references: [id])
  addon Addon @relation(fields: [addonId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([foodId, addonId])
  @@index([tenantId])
}

model Addon {
  id              String         @id @default(cuid())
  tenantId        String
  name            String
  price           Decimal        @db.Decimal(10, 2)
  description     String?
  isActive        Boolean        @default(true)
  imageUrl        String?
  imageSize       Int?
  preparationTime Int?
  allergens       String[]
  nutritionInfo   Json?
  category        AddonCategory?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  scope           AddonScope   @default(GLOBAL) // Options: GLOBAL, BRANCH
  branchId        String?  // Null for global addons, branch-specific otherwise

  // groupAddons     AddonToGroup[]
  foodAddons    FoodAddon[]
  checkoutItems CheckoutItemAddon[]
  branchAddons BranchAddon[]
  branchFoodAddons BranchFoodAddon[]

  createdBy      User             @relation("AddonCreator", fields: [createdById], references: [id])
  createdById    String
  updatedBy      User             @relation("AddonUpdater", fields: [updatedById], references: [id])
  updatedById    String
  deletedBy      User?            @relation("AddonDeleter", fields: [deletedById], references: [id])
  deletedById    String?
  deletedAt      DateTime?
  priceHistory   PriceHistory[]
  OrderItemAddon OrderItemAddon[]
  CartItemAddon  CartItemAddon[]

  @@index([tenantId])
}

enum AddonScope {
  GLOBAL
  BRANCH
}

model BranchAddon {
  id              String   @id @default(cuid())
  branchId        String
  tenantId        String
  addonId         String
  price   Decimal? @db.Decimal(10, 2) // Custom price for this branch

  isAvailable     Boolean  @default(true)     // Branch-specific availability
  overrideNotes   String?  // Optional notes for overrides

  // Relations
  branch          Branch   @relation(fields: [branchId], references: [id])
  addon           Addon    @relation(fields: [addonId], references: [id])
   
   branchFoodAddons BranchFoodAddon[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  priceHistory   PriceHistory[]
  OrderItemAddon OrderItemAddon[]
  CartItemAddon  CartItemAddon[]

  @@unique([branchId, addonId])
  @@index([tenantId])
}



enum AddonCategory {
  TOPPING
  SAUCE
  SIDE
  DRINK
  EXTRA
}

model PriceHistory {
  id          String       @id @default(cuid())
  oldPrice    Decimal      @db.Decimal(10, 2)
  newPrice    Decimal      @db.Decimal(10, 2)
  changeDate  DateTime     @default(now())
  foodId      String?
  variantId   String?
  addonId     String?
  food        Food?        @relation(fields: [foodId], references: [id])
  variant     FoodVariant? @relation(fields: [variantId], references: [id])
  addon       Addon?       @relation(fields: [addonId], references: [id])

  branchAddonId String?
  branchAddon BranchAddon? @relation(fields: [branchAddonId], references: [id])

  changedById String
}

model Order {
  id          String      @id @default(cuid())
  tenantId    String
  orderNumber String      @unique
  userId      String
  user        User        @relation("UserOrders", fields: [userId], references: [id])
  branchId    String
  branch      Branch      @relation(fields: [branchId], references: [id])
  status      OrderStatus @default(PENDING)
  orderType   OrderType
  totalAmount Decimal     @db.Decimal(10, 2)
  items       OrderItem[]
  riderId     String?
  rider       User?       @relation("RiderOrders", fields: [riderId], references: [id])
  address     Address?    @relation(fields: [addressId], references: [id])
  addressId   String?
  tableNumber String? // For dine-in orders
  notes       String?

  payment        Payment?
  promotion      Promotion? @relation(fields: [promotionId], references: [id])
  promotionId    String?
  discountAmount Decimal    @default(0) @db.Decimal(10, 2)
  // tableId       String?
  // table         Table?        @relation(fields: [tableId], references: [id])

  deletedAt DateTime? // Soft delete
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  estimatedDeliveryTime DateTime?
  actualDeliveryTime    DateTime?
  cancelReason          String?
  rating                Int?
  review                String?
  Feedback              Feedback[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([branchId, status])
  @@index([tenantId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum OrderType {
  DELIVERY
  TAKEAWAY
  DINE_IN
}

model OrderItem {
  id        String           @id @default(cuid())


  orderId   String
  order     Order            @relation(fields: [orderId], references: [id])
  foodId    String
  food      Food             @relation(fields: [foodId], references: [id])
  variantId String?
  variant   FoodVariant?     @relation(fields: [variantId], references: [id])
  branchFoodVariantId String?
  branchFoodVariant BranchFoodVariant? @relation(fields: [branchFoodVariantId], references: [id])

  
  quantity  Int
  unitPrice Decimal          @db.Decimal(10, 2)
  addons    OrderItemAddon[]
  subtotal  Decimal          @db.Decimal(10, 2)
}

model OrderItemAddon {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  quantity    Int
  unitPrice   Decimal   @db.Decimal(10, 2)

  addonId     String
  addon       Addon     @relation(fields: [addonId], references: [id])
  branchAddonId String?
  branchAddon BranchAddon? @relation(fields: [branchAddonId], references: [id])
}

model Address {
  id                   String   @id @default(cuid())
  userId               String
  street               String
  city                 String
  state                String?
  postalCode           String?
  latitude             String?
  longitude            String?
  isDefault            Boolean  @default(false)
  label                String? // Add this field for Home, Office, etc.
  additionalDirections String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id])

  orders    Order[]
  checkouts Checkout[]

  @@index([userId, isDefault])
}

model Restaurant {
  id          String  @id @default(cuid())
  name        String // "Burger Palace"
  tenantId    String  @unique // "burgerpalace"
  logo        String? // "https://storage.com/logos/burger-palace.png"
  description String? // "Best burgers in town since 1995"

  domain      String  @unique // "burgerpalace.foodapp.com"
  customDomain Domain[]
  // Primary Admin (Owner)
  adminId String @unique
  admin   User   @relation("RestaurantAdmin", fields: [adminId], references: [id])

  // Business Info
  address     String? // "123 Main Street, Gulshan-1"
  phoneNumber String? // "+880171234567"
  email       String? // "info@burgerpalace.com"

  // Rating & Status
  ratings  Decimal? @db.Decimal(3, 2) // 4.50 out of 5.00
  isActive Boolean  @default(true) // Restaurant is operating

  // Social Media - Stored as JSON
  socialMediaLinks Json? // {
  // "facebook": "fb.com/burgerpalace",
  // "instagram": "instagram.com/burgerpalace"
  // }

  // branch handling
  isSingleBranch  Boolean  @default(false)
  defaultBranchId String?  @unique
  defaultBranch   Branch?  @relation("DefaultBranch", fields: [defaultBranchId], references: [id])
  branches        Branch[] @relation("RestaurantBranches")
  restaurantStaff RestaurantStaff[] @relation("RestaurantStaff")

  // Relations
  settings     RestaurantSettings?
  pointsSystem PointsSystem?
  userPoints   UserPoints[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([tenantId])
}


model Domain {
  id           String     @id @default(cuid())
  domain       String     @unique // "burgerpalace.com"
  isCustom     Boolean    @default(false)
  isVerified   Boolean    @default(false)
  isPrimary    Boolean    @default(false)
  status       DomainStatus @default(PENDING)
  
  // DNS verification
  dnsRecord    String?    // TXT record for verification
  verifiedAt   DateTime?
  
  // SSL certificate status
  sslStatus    SSLStatus? @default(PENDING)
  sslExpiresAt DateTime?
  
  // Relations
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([domain])
  @@index([restaurantId])
}

enum DomainStatus {
  PENDING
  ACTIVE
  FAILED
  EXPIRED
}

enum SSLStatus {
  PENDING
  ACTIVE
  FAILED
  EXPIRED
}

model RestaurantStaff {
  id        String  @id @default(cuid())
  tenantId  String  // reference to restaurant.tenantId
  userId    String  // reference to user.id
  isActive  Boolean @default(true)
  role RestaurantStaffRole

  restaurantId String
  restaurant   Restaurant @relation("RestaurantStaff", fields: [restaurantId], references: [id])
  user         User       @relation("RestaurantStaff", fields: [userId], references: [id])

  @@unique([userId, restaurantId])
  @@index([tenantId])
}

enum RestaurantStaffRole {
  ADMIN
  SUB_ADMIN
  STAFF
  MANAGER
  MODERATOR
  RIDER

}

enum restaurantType {
  FAST_FOOD
  FINE_DINING
  CAFE
}

// Restaurant Settings
model RestaurantSettings {
  id           String     @id @default(cuid())
  tenantId     String     @unique
  restaurantId String     @unique
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // Basic Settings
  currency       String @default("BDT")
  currencySymbol String @default("৳")
  timezone       String @default("Asia/Dhaka")

  // Delivery Settings
  baseDeliveryFee            Decimal?        @db.Decimal(10, 2)
  deliveryFeeCalculationType DeliveryFeeType @default(FIXED)

  // Distance-based delivery fees
  distanceBasedFees Json? // Example:
// {
//     "baseFee": 50,
//     "perKmCharge": 10,
//     "ranges": [
//       {"minKm": 0, "maxKm": 2, "fee": 60},
//       {"minKm": 2, "maxKm": 5, "fee": 80},
//       {"minKm": 5, "maxKm": 8, "fee": 120}
//     ]
//   }

  // // Zone-based delivery fees
  zoneBasedFees Json? // Example:

  //   "zones": [
  //     {
  //       "name": "Gulshan",
  //       "fee": 50,
  //       "estimatedTime": "30-45"
  //     },
  //     {
  //       "name": "Banani",
  //       "fee": 70,
  //       "estimatedTime": "40-55"
  //     },
  //     {
  //       "name": "Dhanmondi",
  //       "fee": 100,
  //       "estimatedTime": "45-60"
  //     }
  //   ]
  // } 

  minOrderForFreeDelivery Decimal? @db.Decimal(10, 2)
  maxDeliveryDistance     Decimal? @db.Decimal(10, 2)

  // Order Settings
  minOrderAmount       Decimal? @db.Decimal(10, 2)
  maxOrderAmount       Decimal? @db.Decimal(10, 2)
  taxPercentage        Decimal  @db.Decimal(5, 2)
  serviceChargePercent Decimal? @db.Decimal(5, 2)

  // Checkout Settings
  allowGuestCheckout Boolean @default(false)
  requirePhoneNumber Boolean @default(true)
  requireEmail       Boolean @default(false)

  // Order Types
  takeoutEnabled       Boolean  @default(true)
  takeoutServiceCharge Decimal? @db.Decimal(5, 2)
  dineInEnabled        Boolean  @default(true)
  dineInServiceCharge  Decimal? @db.Decimal(5, 2)

  // Messages
  globalMessage        String?
  globalMessageEnabled Boolean @default(false)

  // business critical settings
  // subscriptionPlanId String?
  // subscriptionPlan   SubscriptionPlan? @relation("RestaurantSubscriptionPlan", fields: [subscriptionPlanId], references: [id])

  customerSupportEmail    String?
  restaurantType          restaurantType? // E.g., "Fast Food", "Fine Dining"
  serviceChargePercentage Decimal?        @db.Decimal(5, 2)
  acceptsPreorders        Boolean         @default(false)
  autoAssignRiders        Boolean         @default(false)
  smsNotifications        Boolean         @default(true)
  emailNotifications      Boolean         @default(true)
  errorNotificationEmail  String?
  notifyOnCriticalErrors  Boolean         @default(true)
  autoResponseEnabled     Boolean         @default(false)
  feedbackResponseDelay   Int             @default(24) // hours
  lastUpdatedBy           User?           @relation("RestaurantSettingsUpdater", fields: [lastUpdatedById], references: [id])
  lastUpdatedById         String?
  timezoneOffset          Int? // Numeric offset for timezone
  updatedAt               DateTime        @updatedAt
}

// subscription plan
model SubscriptionPlan {
  id          String  @id @default(cuid())
  name        String
  description String?
  maxBranches Int     @default(1)
  maxUsers    Int     @default(1)

  paymentProviders String[] @default([]) // ["stripe", "paypal", "razorpay"]

  price       Decimal @db.Decimal(10, 2)

  // relations
  // restaurants Restaurant[] @relation("RestaurantSubscriptionPlan")
}

// Points System
model PointsSystem {
  id           String     @id @default(cuid())
  tenantId     String     @unique
  restaurantId String     @unique
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  // Basic Settings
  isEnabled      Boolean @default(false)
  pointsRate     Decimal @db.Decimal(10, 2) // 1.00 (1 point per 100 bdt currency)
  redemptionRate Decimal @db.Decimal(10, 2) // 0.50 (0.50 bdt per point)

  // Limits
  minPointsRedeem   Int      @default(100) // minimum points to redeem
  maxPointsRedeem   Int? // maximum points to redeem
  minSpendForPoints Decimal? @db.Decimal(10, 2) // minimum spend to earn points

  // Expiry Settings
  pointsExpiryDays Int? // Days until points expire
  pointsExpiryType PointsExpiryType @default(DAYS)
  // Relations
  userPoints       UserPoints[]
}

enum PointsExpiryType {
  DAYS
  MONTHS
}

model UserPoints {
  id           String @id @default(cuid())
  userId       String
  restaurantId String
  points       Int    @default(0) // current points 150

  // Tracking
  totalPointsEarned   Int       @default(0) // total points earned 200
  totalPointsRedeemed Int       @default(0) // total points redeemed 50
  lastEarnedAt        DateTime?
  lastRedeemedAt      DateTime?
  pointsExpiryDate    DateTime?

  // Relations
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant     Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  pointsSystem   PointsSystem?   @relation(fields: [pointsSystemId], references: [id], onDelete: Cascade)
  pointsSystemId String?
  pointsHistory  PointsHistory[]
  checkout       Checkout[]

  @@unique([userId, restaurantId])
}

model PointsHistory {
  id           String     @id @default(cuid())
  userPointsId String
  userPoints   UserPoints @relation(fields: [userPointsId], references: [id])

  type        PointsTransactionType // EARNED, REDEEMED, EXPIRED, ADJUSTED
  points      Int // amount of points 100
  orderId     String? // checkout id or order id
  description String? // Points earned for order #SK2395303434f3

  createdAt DateTime @default(now())
}

model Checkout {
  id          String @id @default(cuid())
  tenantId    String
  orderNumber String @unique

  // Relations
  userId   String?
  user     User?   @relation(fields: [userId], references: [id])
  branchId String
  branch   Branch  @relation(fields: [branchId], references: [id])

  // Order Details
  orderType OrderType // DELIVERY, TAKEAWAY, DINE_IN
  status    CheckoutStatus @default(PENDING)

  // Price Breakdown
  subtotal       Decimal @db.Decimal(10, 2) // total price of the order 600
  deliveryFee    Decimal @db.Decimal(10, 2) // delivery fee 50
  serviceCharge  Decimal @db.Decimal(10, 2) // service charge 10
  tax            Decimal @db.Decimal(10, 2) // tax 10
  discount       Decimal @db.Decimal(10, 2) // discount 10
  pointsDiscount Decimal @db.Decimal(10, 2) // 10 points discount
  total          Decimal @db.Decimal(10, 2) // total price 650

  // Points
  // pointsSystemId      String?
  // pointsSystem        PointsSystem? @relation(fields: [pointsSystemId], references: [id])
  // userPointsId        String?
  // userPoints          UserPoints? @relation(fields: [userPointsId], references: [id])

  userPoints UserPoints[]

  // Customer Info
  phoneNumber String?
  email       String?
  notes       String?

  // Delivery/Pickup
  addressId   String?
  address     Address? @relation(fields: [addressId], references: [id])
  tableNumber String?

  // Payment
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)

  items CheckoutItem[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model CheckoutItem {
  id         String              @id @default(cuid())
  checkoutId String
  checkout   Checkout            @relation(fields: [checkoutId], references: [id])
  foodId     String
  food       Food                @relation(fields: [foodId], references: [id])
  quantity   Int
  // variant
  branchFoodVariantId String?
  branchFoodVariant BranchFoodVariant? @relation(fields: [branchFoodVariantId], references: [id])
  variantId  String?
  variant    FoodVariant?        @relation(fields: [variantId], references: [id])
  unitPrice  Decimal             @db.Decimal(10, 2)

  // addons
  addons     CheckoutItemAddon[]
  addonTotal Decimal             @db.Decimal(10, 2)
  subtotal   Decimal             @db.Decimal(10, 2)

  @@index([checkoutId])
}

model CheckoutItemAddon {
  id             String       @id @default(cuid())
  checkoutItemId String
  checkoutItem   CheckoutItem @relation(fields: [checkoutItemId], references: [id])
  addonId        String
  addon          Addon        @relation(fields: [addonId], references: [id])
  quantity       Int
  unitPrice      Decimal      @db.Decimal(10, 2)

  @@index([checkoutItemId])
}

enum DeliveryFeeType {
  FIXED
  DISTANCE_BASED
  ZONE_BASED
}

enum CheckoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_BANKING
  ONLINE
}

enum PointsTransactionType {
  EARNED
  REDEEMED
  EXPIRED
  ADJUSTED
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id])
  branchId  String
  branch    Branch     @relation(fields: [branchId], references: [id])
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId, branchId])
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  foodId    String
  food      Food            @relation(fields: [foodId], references: [id])
  variantId String?
  variant   FoodVariant?    @relation(fields: [variantId], references: [id])
  quantity  Int
  addons    CartItemAddon[]
  branchFoodVariantId String?
  branchFoodVariant BranchFoodVariant? @relation(fields: [branchFoodVariantId], references: [id])
}

model CartItemAddon {
  id         String   @id @default(cuid())
  cartItemId String
  cartItem   CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  quantity   Int
  
  addonId    String
  addon      Addon    @relation(fields: [addonId], references: [id])
  
  branchAddonId String?
  branchAddon BranchAddon? @relation(fields: [branchAddonId], references: [id])
}

model Payment {
  id            String        @id @default(cuid())
  tenantId      String
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id])
  amount        Decimal       @db.Decimal(10, 2)
  status        PaymentStatus @default(PENDING)
  method        PaymentMethod
  transactionId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([tenantId])
}

model Promotion {
  id             String        @id @default(cuid())
  tenantId       String
  promoCode      String        @unique
  type           PromotionType
  value          Decimal       @db.Decimal(10, 2)
  minOrderAmount Decimal?      @db.Decimal(10, 2)
  maxDiscount    Decimal?      @db.Decimal(10, 2)
  startDate      DateTime
  endDate        DateTime

  // Additional useful fields
  description     String? // Explain what the promotion offers
  terms           String? // Terms and conditions
  userType        UserType? // Target specific user types (new/existing)
  maxUsagePerUser Int? // Limit usage per user
  applicableItems Json? // Specific foods/categories this applies to
  excludedItems   Json? // Items excluded from promotion
  priority        Int       @default(0) // For handling multiple applicable promotions

  // Tracking fields
  totalRedemptions  Int   @default(0) // Track total times used
  redemptionHistory Json? // Detailed usage history

  promotionBanner PromotionBanner[]
  isActive        Boolean           @default(true)
  usageLimit      Int?
  usedCount       Int               @default(0)
  displayLocation String? // Home, Menu, Checkout
  branchId        String?
  branch          Branch?           @relation(fields: [branchId], references: [id])

  userRedemption UserPromotion[] //track user redemption

  //  relation with food
  foods Food[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Order     Order[]

  @@index([tenantId])
}

enum UserType {
  ALL
  NEW_USER
  EXISTING_USER
  VIP
}

model UserPromotion {
  id          String   @id @default(cuid())
  userId      String
  promotionId String
  usageCount  Int      @default(0)
  lastUsedAt  DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id])
  promotion Promotion @relation(fields: [promotionId], references: [id])

  @@unique([userId, promotionId])
}

model PromotionBanner {
  id          String     @id @default(cuid())
  url         String
  width       Int
  height      Int
  size        Int
  deviceType  DeviceType
  promotionId String
  promotion   Promotion  @relation(fields: [promotionId], references: [id])
}

enum PromotionType {
  PERCENTAGE
  FIXED
}

model Notification {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())

  @@index([tenantId])
}

enum NotificationType {
  ORDER_STATUS
  PROMOTION
  SYSTEM
  PAYMENT
  STAFF_STATUS
}

model AuditLog {
  id         String         @id @default(cuid())
  tenantId   String
  userId     String
  user       User           @relation(fields: [userId], references: [id])
  action     AuditLogAction
  entityType String // BRANCH, FOOD, ORDER, USER, PROMOTION, ADDON, CATEGORY, ADDRESS, PAYMENT, CHECKOUT, CHECKOUT_ITEM, CHECKOUT_ITEM_ADDON, CHECKOUT_ITEM_PROMOTION, CHECKOUT_ITEM_ADDON_PROMOTION, CHECKOUT_PROMOTION, CHECKOUT_ITEM_PROMOTION_ADDON, CHECKOUT_ITEM_PROMOTION_ADDON_PROMOTION, CHECKOUT_ITEM_PROMOTION_ADDON_PROMOTION_PROMOTION
  entityId   String // Id of the entity being audited
  oldData    Json? // Old data of the entity
  newData    Json? // New data of the entity
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime       @default(now())

  // relations
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType])
}

enum AuditLogAction {
  CREATE
  UPDATE
  DELETE
}

model Feedback {
  id        String         @id @default(cuid())
  userId    String
  tenantId  String
  user      User           @relation(fields: [userId], references: [id])
  orderId   String?
  order     Order?         @relation(fields: [orderId], references: [id])
  rating    Int
  review    String?
  type      FeedbackType
  response  String?
  status    FeedbackStatus @default(PENDING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId, createdAt])
  @@index([orderId])
  @@index([tenantId])
}

enum FeedbackType {
  ORDER
  FOOD
  SERVICE
  APP
  OTHER
}

enum FeedbackStatus {
  PENDING
  RESPONDED
  RESOLVED
  IGNORED
}
